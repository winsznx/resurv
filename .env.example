# Copy to .env and fill in. .env is gitignored and must never be committed.
# Never paste real values into chat, a terminal echo, a log line, or an issue.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Organization API key from app.keeperhub.com -> Settings -> API Keys -> Organisation tab.
# MUST start with kh_. A wfb_ key is a *user* key for webhook triggers and cannot call the
# execution endpoints; @resurv/config rejects it by name rather than surfacing a bare 401.
# Broadcasting needs the mcp:write scope. simulate:true works with mcp:read alone.
KEEPERHUB_API_KEY=kh_...

# ---------------------------------------------------------------------------
# OPTIONAL: compiled-in defaults are correct for Base Sepolia. Override only with reason.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
CHAIN_ID=84532

# Independent verification. A run is proven only when a receipt from a node we do not
# control agrees with what KeeperHub reported, so two origins are kept.
RPC_URL_PRIMARY=https://sepolia.base.org
RPC_URL_SECONDARY=https://base-sepolia-rpc.publicnode.com

LOG_LEVEL=info

# Set after the covenant contract is deployed. See docs/DEPLOYMENTS.md.
RESURV_CONTRACT_ADDRESS=

# ---------------------------------------------------------------------------
# DATABASE: not required until the orchestrator needs durable state.
# Server-side only. These must never reach browser code.
# ---------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ---------------------------------------------------------------------------
# MAINTAINER-ONLY: not part of the normal development flow.
# Used once to deploy contracts. A contributor running tests does NOT need this.
# ---------------------------------------------------------------------------

DEPLOYER_PRIVATE_KEY=
