{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(pnpm gate)",
      "Bash(pnpm clean)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm why:*)",
      "Bash(pnpm list:*)",
      "Bash(pnpm outdated:*)",
      "Bash(pnpm dlx biome:*)",

      "Bash(node --version)",
      "Bash(node -e:*)",
      "Bash(turbo run:*)",
      "Bash(npx biome:*)",

      "Bash(forge build:*)",
      "Bash(forge test:*)",
      "Bash(forge fmt:*)",
      "Bash(forge coverage:*)",
      "Bash(forge clean)",
      "Bash(forge inspect:*)",
      "Bash(forge selectors:*)",
      "Bash(forge --version)",
      "Bash(anvil:*)",
      "Bash(cast call:*)",
      "Bash(cast block:*)",
      "Bash(cast receipt:*)",
      "Bash(cast tx:*)",
      "Bash(cast logs:*)",
      "Bash(cast code:*)",
      "Bash(cast storage:*)",
      "Bash(cast balance:*)",
      "Bash(cast sig:*)",
      "Bash(cast 4byte:*)",
      "Bash(cast abi-decode:*)",
      "Bash(cast keccak:*)",
      "Bash(cast to-unit:*)",
      "Bash(cast from-wei:*)",
      "Bash(cast chain-id:*)",

      "Bash(wrangler types:*)",
      "Bash(wrangler versions list:*)",
      "Bash(wrangler deployments list:*)",
      "Bash(wrangler whoami)",
      "Bash(pnpm --filter @resurv/worker build)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash list)",

      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(jq:*)"
    ],
    "ask": [
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm update:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm approve-builds:*)",
      "Bash(forge install:*)",
      "Bash(forge script:*)",
      "Bash(forge create:*)",
      "Bash(forge verify-contract:*)",
      "Bash(cast send:*)",
      "Bash(cast wallet:*)",
      "Bash(wrangler deploy:*)",
      "Bash(wrangler secret:*)",
      "Bash(wrangler delete:*)",
      "Bash(wrangler d1:*)",
      "Bash(wrangler kv:*)",
      "Bash(wrangler r2:*)",
      "Bash(supabase:*)",
      "Bash(psql:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(curl:*)",
      "Bash(gh:*)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./keystores/**)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Read(//Users/mac/.foundry/keystores/**)",
      "Read(//Users/mac/.ssh/**)",
      "Read(//Users/mac/.aws/**)",
      "Read(//Users/mac/.config/gcloud/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git filter-branch:*)",
      "Bash(git update-ref -d:*)",

      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(curl:*| sh)",
      "Bash(curl:*| bash)",
      "Bash(wget:*| sh)",

      "Bash(cast wallet export:*)",
      "Bash(cast wallet private-key:*)",
      "Bash(wrangler secret list:*)",

      "Bash(forge script:*--broadcast:*--rpc-url:*mainnet:*)",
      "Bash(cast send:*--rpc-url:*mainnet:*)"
    ]
  }
}
