{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resurv",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],

  // Single deployable: the Worker answers /api/* and serves the built SPA for everything
  // else. Two origins would mean CORS and a second deploy for no architectural benefit.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Non-secret configuration only. Secrets are set with `wrangler secret put` and are
  // never written to this file. See docs/DEPLOYMENTS.md.
  "vars": {
    "ENVIRONMENT": "development",
    "CHAIN_ID": "84532",
    "RPC_URL_PRIMARY": "https://sepolia.base.org",
    "RPC_URL_SECONDARY": "https://base-sepolia-rpc.publicnode.com",
    "LOG_LEVEL": "info"
  },

  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "CHAIN_ID": "84532",
        "RPC_URL_PRIMARY": "https://sepolia.base.org",
        "RPC_URL_SECONDARY": "https://base-sepolia-rpc.publicnode.com",
        "LOG_LEVEL": "info"
      }
    }
  }
}
